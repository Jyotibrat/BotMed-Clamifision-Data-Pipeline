# Copy this file to .env (same folder) and fill in your real values.
# .env is loaded automatically by config.py via python-dotenv -- you do
# NOT need to `export` these manually or restart your shell.

# --- NCBI / PubMed ---
# Any email is fine -- NCBI just wants a contact for API etiquette.
NCBI_EMAIL=you@example.com
# Optional. Get one at: NCBI account -> Account Settings -> API Key Management
NCBI_API_KEY=

# --- Wikipedia ---
# Wikimedia's User-Agent policy throttles requests without contact info
# more aggressively. Leave blank to reuse NCBI_EMAIL automatically.
WIKIPEDIA_CONTACT=

# --- Kaggle ---
# Only needed here if you don't want to use ~/.kaggle/kaggle.json.
# If you already placed kaggle.json as described in the README, leave these blank.
KAGGLE_USERNAME=
KAGGLE_KEY=
